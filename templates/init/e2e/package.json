{
  "name": "e2e-suite",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright suite generated by Flint. Runs standalone — no Flint dependency.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ready": "playwright test --grep-invert @needs-setup",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
